# Committed on purpose: Hostinger builds from this repo and NEXT_PUBLIC_* values
# are inlined at build time. A Meta Pixel ID is a public identifier (it ships in
# the HTML of every page), so it is safe to keep here. Real secrets never go in
# this file — use the hosting panel's environment variables for those.
NEXT_PUBLIC_META_PIXEL_ID=1052917610943789
