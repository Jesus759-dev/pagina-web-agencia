# Copy to .env.local for local development.
# Meta (Facebook/Instagram) Pixel ID — Administrador de eventos → píxel → "ID del conjunto de datos".
# Leave empty to disable the pixel (nothing is rendered).
NEXT_PUBLIC_META_PIXEL_ID=
# Calendly / Cal.com event URL for /agenda (empty = WhatsApp booking flow)
NEXT_PUBLIC_CALENDLY_URL=

# ---- Chatbot del sitio (/api/chat) — SECRETOS: configúralos en el panel de Hostinger, nunca en el repo ----
# El bot solo aparece si hay ANTHROPIC_API_KEY y al menos un canal de aviso (Telegram o correo).
ANTHROPIC_API_KEY=
# Solo si tu llave NO está asignada a un workspace (error "not scoped to a workspace"): ID del workspace
ANTHROPIC_WORKSPACE_ID=
# Modelo (por defecto claude-opus-5)
CHAT_MODEL=
# Avisos por Telegram: token de @BotFather y tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Avisos por correo (Resend): solo contactos y citas
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# --- Captura de prospectos (formulario y chatbot) ---
# Correo donde llegan los prospectos. Por defecto ventas@neuroviasystems.com.mx.
LEADS_EMAIL_TO=ventas@neuroviasystems.com.mx
# Resend: ya se usa para los avisos del chatbot (RESEND_API_KEY / NOTIFY_EMAIL_FROM).
# Si el dominio está verificado en Resend, pon NOTIFY_EMAIL_FROM con tu dominio:
# NOTIFY_EMAIL_FROM=Prospectos Neurovia <prospectos@neuroviasystems.com.mx>
